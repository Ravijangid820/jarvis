# ==============================================================================
# JARVIS — PUBLIC DEMO runtime configuration
# ==============================================================================
# Copy to .env.demo and edit. Used with docker-compose.demo.yml:
#   docker compose -p jarvis-demo --env-file .env.demo -f docker-compose.demo.yml up -d
#
# This file configures the PUBLIC demo container only. The lab/production instance uses
# .env.prod + docker-compose.prod.yml and shares nothing with it — different volume,
# different database, no Home Assistant credentials here.
# ==============================================================================

# --- Container Images ---
ORCH_IMAGE=ghcr.io/ravijangid820/jarvis-orchestrator:latest
LLAMA_IMAGE=ghcr.io/ravijangid820/jarvis-llama:latest

# --- Container Interconnection ---
JARVIS_FAST_BRAIN_URL=http://llama:8081/v1/chat/completions

# --- Public Access & CORS ---
# The origin the public SPA is served from (GitHub Pages / your domain).
ALLOWED_ORIGINS=https://ravi-mk42.me

# Host port for the demo API. Differs from the production stack's 5000 so both can run at once.
HOST_PORT=5001

# --- Demo behaviour ---
# Minutes of INACTIVITY before a visitor's sandbox is destroyed. The expiry slides forward on
# every request, so this bounds idle time, not session length — someone reading a long answer
# is not cut off mid-conversation.
DEMO_TTL_MINUTES=60

# How many demo sessions one IP may start per hour. This bounds how fast the households/users
# tables can grow, not throughput.
DEMO_MINT_PER_IP_HOURLY=10

# --- The demo container's own admin ---
# Separate from the demo/demo login the UI suggests (that mints throwaway sandboxes). This
# account owns household 1 on the demo box and can see the admin console for it.
ADMIN_USER=admin
ADMIN_PASS=change-me-before-exposing-this

# --- Model ---
EMBED_MODEL=google/embeddinggemma-300m

# NOTE: HA_URL / HA_TOKEN are intentionally absent. A public demo must not hold credentials for
# a real smart home; the orchestrator additionally refuses HA routes for any household that does
# not own a smart-home connection, so this is belt and braces.
