# jarvis-frontend — Nginx site config.
#
# Rendered at container start by the official nginx image's envsubst hook
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf). Only ${JARVIS_*} variables are
# substituted (NGINX_ENVSUBST_FILTER in Dockerfile.frontend), so nginx's own $uri / $host /
# $scheme survive untouched.
#
#   JARVIS_API_UPSTREAM   where the orchestrator lives, e.g. http://orchestrator:5000
#                         (default set in Dockerfile.frontend; override with -e / compose)
#
# The SPA is built with VITE_API_URL=/api, so every API call arrives here as /api/… and is
# proxied to the orchestrator. That is the whole wiring between the two containers: one env var
# and this block. Change the API prefix and you must rebuild the SPA to match.

# Websocket/upgrade handling: pass "upgrade" ONLY for requests that actually ask for it. A blanket
# `Connection: upgrade` on ordinary requests confuses some HTTP/1.1 stacks and breaks keep-alive.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # 8080, not 80: ports below 1024 need CAP_NET_BIND_SERVICE, and this container drops root.
    # The published port is unchanged — compose maps ${FRONTEND_PORT:-80} to 8080 — so nothing
    # about how you reach it differs.
    listen 8080;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression. Not for the model bundles below — .onnx weights are already compressed and
    # gzipping 38 MB per request just burns CPU.
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1000;

    # Cross-origin isolation: without these two the browser withholds SharedArrayBuffer and the
    # in-browser Whisper runtime drops to a single thread. Kept in step with the orchestrator's
    # _apply_security_headers — if one side changes, change both.
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy require-corp always;

    # SPA client-side routing fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --- Browser-side model bundles, baked into this image ------------------------------------
    # The SPA's Web Workers fetch these from the origin serving the SPA — THIS one — not from the
    # API. Public, SHA-256-pinned upstream weights: no secret, and a worker cannot attach a Bearer
    # token anyway. `=404` rather than the SPA fallback is deliberate: without it a missing file
    # returns index.html with a 200, and the ONNX runtime hangs trying to parse HTML as a model
    # instead of reporting a clean failure.
    #
    # no-cache, not immutable: the filenames are fixed, so re-pinning a bundle would swap the bytes
    # under a URL browsers had been told never to revalidate. ETags make the normal case a 304.
    location ~ ^/(stt-models|face-models|wake-models)/ {
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cross-Origin-Resource-Policy same-origin always;
        add_header Cache-Control "public, no-cache" always;
        gzip off;
        try_files $uri =404;
    }

    # The ONNX Runtime itself, vendored into the build under /ort/<version>/. Version-scoped, so
    # it is genuinely content-addressed and may be cached forever.
    location /ort/ {
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        gzip off;
        try_files $uri =404;
    }

    # --- API: reverse proxy to the orchestrator -----------------------------------------------
    location /api/ {
        proxy_pass ${JARVIS_API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /chat/stream streams tokens and /voice/server-mic/stream streams PCM. With buffering on
        # (the default) nginx holds the response until its buffer fills, which turns a live stream
        # into a long silence followed by a burst — the single easiest way to make a working
        # backend look broken.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Backup uploads and audio posts are far larger than nginx's 1 MB default.
        client_max_body_size 256m;
    }

    # Error pages
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
